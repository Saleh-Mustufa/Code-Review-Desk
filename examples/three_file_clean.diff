--- a/app/billing.py
+++ b/app/billing.py
@@ -1,9 +1,13 @@
 def compute_invoice(items, tax_rate):
-    total = sum(items)
-    return total
+    if not items:
+        raise ValueError("invoice requires at least one item")
+    subtotal = sum(items)
+    return subtotal * (1 + tax_rate)
+
+
+def apply_discount(total, percent):
+    return total - total * percent / 100
