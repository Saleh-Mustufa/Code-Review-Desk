+import datetime as dt
+
+
 class Reminder:
     def __init__(self, title, due):
         self.title = title
         self.due = due
+
+    def is_overdue(self, now=None):
+        now = now or dt.datetime.now()
+        return self.due < now

-    def notify(self, user):
-        print("Sending notification to " + user)

+    def notify(self, user):
+        print(f"Sending notification to {user}")
